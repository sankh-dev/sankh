  - var: USER_ID
    source:
      type: jq
      expr: ".data.id"
mode: form
raw_reason: ~
curl:
  method: POST
  url: $BASE_URL/users
  headers:
    - name: Authorization
      value: Bearer $TOKEN
    - name: Content-Type
      value: application/json
  body: "{\"name\":\"test\"}"
  body_flag: ~
  flags:
    - "-sS"
extra_header_lines: []
shebang: "#!/usr/bin/env bash"
body: "curl -sS -X POST \"$BASE_URL/users\" \\\n  -H \"Authorization: Bearer $TOKEN\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"name\":\"test\"}'\n"
diagnostics: []
