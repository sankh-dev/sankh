curl -sS https://s3.amazonaws.com/bucket

=== 02-quoting-it-s-5-quoted/04-raw-starting-with-at.sh
#!/usr/bin/env bash
# @name Raw starting with at
curl -sS "${BASE_URL}/text" \
  -H 'Content-Type: text/plain' \
  --data-raw @literal

=== 04-bare-url-request.sh
#!/usr/bin/env bash
# @name Bare URL request
curl -sS https://example.com/health

=== 05-legacy-v2-0-bearer.sh
#!/usr/bin/env bash
# @name Legacy v2.0 bearer
curl -sS -g "${BASE_URL}/legacy?expand[]=card" \
  -H 'Accept: application/json' \
  -H 'X-Version: 2' \
  -H "Authorization: Bearer ${BEARER_TOKEN}"

=== environments/default.env
# Imported from environment "default"
BASE_URL=https://api.example.com
CURRENCY=EUR
GREETING="hello \"world\" from ${CURRENCY}"

=== sankh.toml
name = "Messy API"
format = 1
default_env = "default"

=== .gitignore
.env.local
sankh-report.*

=== .env.example
# Copy to .env.local (gitignored) and fill in. Secrets never go in environments/*.env.

# basic auth username; the literal value from Postman was not written to disk
BASIC_USER=

# basic auth password; the literal value from Postman was not written to disk
BASIC_PASSWORD=

# bearer token; the literal value from Postman was not written to disk
BEARER_TOKEN=

# secret; its value was not written to environments/ (set it in .env.local or CI)
API_KEY=

# secret; its value was not written to environments/ (set it in .env.local or CI)
DB_PASSWORD=

# replaces the dynamic variable {{$guid}}; set a value before running
GUID=

# referenced by requests but not defined in the collection or any imported environment
TERM=

# referenced by requests but not defined in the collection or any imported environment
USER_ID=

=== .env.local
# Sample values generated by sankh import; replace before real use.

# basic auth username; the literal value from Postman was not written to disk
BASIC_USER=changeme

# basic auth password; the literal value from Postman was not written to disk
BASIC_PASSWORD=changeme

# bearer token; the literal value from Postman was not written to disk
BEARER_TOKEN=changeme

# secret; its value was not written to environments/ (set it in .env.local or CI)
API_KEY=changeme

# secret; its value was not written to environments/ (set it in .env.local or CI)
DB_PASSWORD=changeme

# replaces the dynamic variable {{$guid}}; set a value before running
GUID=00000000-0000-4000-8000-000000000000

# referenced by requests but not defined in the collection or any imported environment
TERM=changeme

# referenced by requests but not defined in the collection or any imported environment
USER_ID=1
