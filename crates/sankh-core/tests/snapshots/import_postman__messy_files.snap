=== 01-forms-files/01-upload-avatar.sh
#!/usr/bin/env bash
# @name Upload avatar
curl -sS -X POST "${BASE_URL}/avatar" \
  --form-string 'name=@not-a-file;type=text/plain' \
  -F avatar=@/Users/me/Pictures/cat.png

=== 01-forms-files/02-login-form.sh
#!/usr/bin/env bash
# @name Login form
curl -sS -u "${BASIC_USER}:${BASIC_PASSWORD}" -X POST "${BASE_URL}/oauth/token" \
  --data-urlencode grant_type=password \
  --data-urlencode 'scope=read write'

=== 01-forms-files/03-upload-raw-file.sh
#!/usr/bin/env bash
# @name Upload raw file
# @require GUID
curl -sS -X PUT "${BASE_URL}/blobs/${GUID}" \
  --data-binary @./data/blob.bin

=== 02-quoting-it-s-5-quoted/01-echo-tricky-body.sh
#!/usr/bin/env bash
# @name Echo tricky body
# [imported pre-request script, not executed]
# | pm.variables.set('now', Date.now());
# [imported test script, not executed]
# | pm.test('ok', function () {
# |     pm.response.to.be.success;
# |     const body = pm.response.json();
# |     if (body.items.length > 0) { console.log('has items'); }
# | });
# @expect status 2xx
curl -sS "${BASE_URL}/echo?debug=1" \
  -H 'Content-Type: application/json' \
  -H "X-Price: \$5 and ${CURRENCY}" \
  -d "{
  \"text\": \"it's \$HOME \`whoami\` \\\\ ünïcødé 🐚\",
  \"user\": \"${USER_ID}\"
}"

=== 02-quoting-it-s-5-quoted/02-graphql-search.sh
#!/usr/bin/env bash
# @name GraphQL search
curl -sS "${BASE_URL}/graphql?api_key=${API_KEY}" \
  -H 'Content-Type: application/json' \
  -d "{\"query\":\"query Search(\$q: String!) { search(q: \$q) { id } }\",\"variables\":{\"q\":\"${TERM}\"}}"

