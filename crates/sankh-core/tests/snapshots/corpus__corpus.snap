$ curl 'https://example.com/search?q=rust&page=2' \
  -H 'accept: text/html' \
  -H 'sec-ch-ua: "Chromium";v="124", "Not-A.Brand";v="99"' \
  -b 'consent=yes' \
  -H 'sec-fetch-mode: navigate'
GET https://example.com/search?q=rust&page=2
